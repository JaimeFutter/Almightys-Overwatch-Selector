<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": signs only this project's own binaries inside the
     published app folder. Third-party/Microsoft files pass through untouched.
     Paste into SignPath > Project > Artifact Configurations, with slug "app". -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="AlmightysOverwatchSelector.exe" />
      <include path="AlmightysOverwatchSelector.dll" />
      <include path="Aos.Core.dll" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
