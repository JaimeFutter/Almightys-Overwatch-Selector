<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Aos.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Layout shared by every page, matching the Windows 11 Settings app:
                 a fixed title, then a full-width ScrollViewer whose padding keeps the
                 scrollbar at the window edge, outside the cards. -->
            <Thickness x:Key="PageHeaderMargin">36,20,36,12</Thickness>
            <Thickness x:Key="PageScrollPadding">36,0,36,0</Thickness>
            <Thickness x:Key="PageContentMargin">0,0,0,36</Thickness>
            <x:Double x:Key="PageMaxWidth">1000</x:Double>
            <x:Double x:Key="SettingsCardSpacing">4</x:Double>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,28,0,6" />
            </Style>
            <Style x:Key="PageDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
