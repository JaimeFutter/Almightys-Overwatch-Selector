<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Aos.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"
                   Margin="{StaticResource PageHeaderMargin}" MaxWidth="{StaticResource PageMaxWidth}" HorizontalAlignment="Stretch" />

        <ScrollViewer Grid.Row="1" Padding="{StaticResource PageScrollPadding}">
            <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Margin="{StaticResource PageContentMargin}" Spacing="{StaticResource SettingsCardSpacing}">

                <TextBlock Text="Game" Style="{StaticResource SectionHeaderStyle}" Margin="1,0,0,6" />
                <tk:SettingsCard x:Name="GameCard" Header="Overwatch.exe location">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7FC;" /></tk:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Detect" Click="Detect_Click" />
                        <Button Content="Browse…" Click="Browse_Click" />
                    </StackPanel>
                </tk:SettingsCard>

                <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderStyle}" />
                <tk:SettingsExpander x:Name="ThemeExpander" Header="App theme" Description="Choose light or dark, or follow your Windows setting.">
                    <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE790;" /></tk:SettingsExpander.HeaderIcon>
                    <TextBlock x:Name="ThemeSummary" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard HorizontalContentAlignment="Left" ContentAlignment="Left">
                            <RadioButtons x:Name="ThemeChoice" SelectionChanged="Theme_SelectionChanged" MaxColumns="1">
                                <x:String>Light</x:String>
                                <x:String>Dark</x:String>
                                <x:String>Use system setting</x:String>
                            </RadioButtons>
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>

                <TextBlock Text="Window" Style="{StaticResource SectionHeaderStyle}" />
                <tk:SettingsCard Header="Close to the system tray"
                                 Description="The close button keeps the app running in the tray, with a notification the first time. Click the tray icon to reopen it, or right-click it and choose Exit.">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE737;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="CloseToTray" Toggled="CloseToTray_Toggled" />
                </tk:SettingsCard>

                <TextBlock Text="Firewall" Style="{StaticResource SectionHeaderStyle}" />
                <tk:SettingsCard Header="Remove block rules when the app exits"
                                 Description="Unblocks every server when you quit (Exit from the tray, or closing the window when close to tray is off).">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE83D;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="RemoveOnExit" Toggled="RemoveOnExit_Toggled" />
                </tk:SettingsCard>
                <tk:SettingsCard x:Name="RulesCard" Header="Active block rules">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9D9;" /></tk:SettingsCard.HeaderIcon>
                </tk:SettingsCard>

                <TextBlock Text="IP ranges" Style="{StaticResource SectionHeaderStyle}" />
                <tk:SettingsExpander x:Name="SourcesExpander" Header="Server IP sources" IsExpanded="True"
                                     Description="Downloaded IP lists refresh automatically once they're more than 7 days old.">
                    <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE774;" /></tk:SettingsExpander.HeaderIcon>
                    <Button Content="Refresh IPs now" Click="Refresh_Click" />
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard x:Name="GcpCard" Header="Google Cloud" />
                        <tk:SettingsCard x:Name="AwsCard" Header="AWS" />
                        <tk:SettingsCard x:Name="AsnCard" Header="Blizzard network (AS57976)" />
                        <tk:SettingsCard x:Name="CatalogCard" Header="Server catalog" />
                        <tk:SettingsCard x:Name="LearnedCard" Header="Learned server IPs" />
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>
                <tk:SettingsCard x:Name="DataCard" Header="Data folder" Description="Settings, cached IP lists, learned IPs, and your own servers.json if you add one.">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8B7;" /></tk:SettingsCard.HeaderIcon>
                    <Button Content="Open folder" Click="OpenFolder_Click" />
                </tk:SettingsCard>

                <TextBlock Text="About" Style="{StaticResource SectionHeaderStyle}" />
                <tk:SettingsExpander x:Name="AboutExpander" Header="Almighty's Overwatch Selector" Description="Choose which Overwatch servers you can be matched on.">
                    <tk:SettingsExpander.HeaderIcon>
                        <ImageIcon Source="ms-appx:///Assets/app.png" />
                    </tk:SettingsExpander.HeaderIcon>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard HorizontalContentAlignment="Left" ContentAlignment="Left">
                            <StackPanel Spacing="8">
                            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Blocks Overwatch.exe from the regions you choose, using Windows Firewall rules in the group &quot;Almighty's Overwatch Selector&quot;. Game files and other apps aren't touched. Server IPs come from Google Cloud's and AWS's published ranges, Blizzard ranges checked against Blizzard's network (AS57976), and IPs learned during your matches. Use at your own risk." />
                            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Free software under the GNU GPL v3 (or later). Unofficial: not affiliated with or endorsed by Blizzard Entertainment. Overwatch is a trademark of Blizzard Entertainment, Inc." />
                            </StackPanel>
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="Source code, license and releases" IsClickEnabled="True" Click="Repo_Click">
                            <tk:SettingsCard.ActionIcon><FontIcon Glyph="&#xE8A7;" /></tk:SettingsCard.ActionIcon>
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
