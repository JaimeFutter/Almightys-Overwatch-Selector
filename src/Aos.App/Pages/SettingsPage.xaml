<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Aos.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24,12,24,24" Spacing="12" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock Text="Game" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="GamePathBox" Header="Overwatch.exe location" PlaceholderText="Not found" LostFocus="GamePath_LostFocus" />
                <Button Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" Click="Browse_Click" />
                <Button Grid.Column="2" Content="Detect" VerticalAlignment="Bottom" Click="Detect_Click" />
            </Grid>
            <TextBlock x:Name="GameStatus" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <TextBlock Text="Firewall" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
            <ToggleSwitch x:Name="RemoveOnExit" Header="Remove block rules when the app closes" Toggled="RemoveOnExit_Toggled" />
            <TextBlock x:Name="RulesText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <TextBlock Text="IP sources" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
            <TextBlock x:Name="SourcesText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Refresh IPs now" Click="Refresh_Click" />
                <Button Content="Open data folder" Click="OpenFolder_Click" />
            </StackPanel>

            <TextBlock Text="About" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Blocks Overwatch.exe from chosen regions with Windows Firewall rules (group &quot;Almighty's Overwatch Selector&quot;). Game files and other apps are not touched. Server IPs come from Google Cloud's and AWS's published ranges, curated Blizzard ranges checked against Blizzard's network (AS57976), and IPs learned during your matches. To customise the server list, copy servers.json into the data folder and edit it. Use at your own risk." />
        </StackPanel>
    </ScrollViewer>
</Page>
