<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Aos.App.Pages.FirewallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:app="using:Aos.App"
    xmlns:fw="using:Aos.Core.Firewall">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="{StaticResource PageHeaderMargin}" MaxWidth="{StaticResource PageMaxWidth}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Firewall" Style="{StaticResource TitleTextBlockStyle}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
                    <Button Click="Rescan_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Rescan" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource PageDescriptionStyle}"
                       Text="Every Windows Firewall rule that affects Overwatch, including ones made by other tools or by hand. Block rules from other tools can stop you reaching servers you've allowed. Windows' own 'allow' rules are normal; leave those alone." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="{StaticResource PageScrollPadding}">
            <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Margin="{StaticResource PageContentMargin}" Spacing="{StaticResource SettingsCardSpacing}">

                <InfoBar x:Name="DropshipBar" IsOpen="False" IsClosable="False" Severity="Warning" Title="dropship filters found" Margin="0,0,0,8">
                    <InfoBar.ActionButton>
                        <Button Content="Remove dropship filters" Click="RemoveDropship_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <tk:SettingsCard x:Name="RemoveAllCard" Header="Remove all Overwatch block rules">
                    <tk:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE74D;" />
                    </tk:SettingsCard.HeaderIcon>
                    <Button x:Name="RemoveBlocksButton" Content="Remove all" Click="RemoveBlocks_Click" />
                </tk:SettingsCard>

                <ItemsControl x:Name="Groups">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="app:RuleGroup">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeaderStyle}">
                                    <Run Text="{x:Bind Name}" /><Run Text="  " /><Run Text="{x:Bind CountText}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </TextBlock>
                                <ItemsRepeater ItemsSource="{x:Bind Rules}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="{StaticResource SettingsCardSpacing}" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="fw:OverwatchRule">
                                            <tk:SettingsCard Header="{x:Bind Name}">
                                                <tk:SettingsCard.HeaderIcon>
                                                    <FontIcon Glyph="{x:Bind app:RuleGroup.GlyphFor(IsBlock)}" />
                                                </tk:SettingsCard.HeaderIcon>
                                                <tk:SettingsCard.Description>
                                                    <TextBlock TextTrimming="CharacterEllipsis" Text="{x:Bind DetailText}" />
                                                </tk:SettingsCard.Description>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <ToggleSwitch IsOn="{x:Bind Enabled}" Tag="{x:Bind Key}" OnContent="On" OffContent="Off" Toggled="Enabled_Toggled" MinWidth="0" />
                                                    <Button Tag="{x:Bind Key}" Click="Delete_Click" ToolTipService.ToolTip="Delete this rule" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                                    </Button>
                                                </StackPanel>
                                            </tk:SettingsCard>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyText" Visibility="Collapsed" Style="{StaticResource PageDescriptionStyle}" Margin="0,16,0,0"
                           Text="No firewall rules mention Overwatch. It can reach every server." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
