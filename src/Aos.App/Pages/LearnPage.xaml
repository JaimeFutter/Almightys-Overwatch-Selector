<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Aos.App.Pages.LearnPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Aos.App">

    <ScrollViewer>
        <StackPanel Padding="24,12,24,24" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel Spacing="2">
                <TextBlock Text="Learn" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Watches the traffic Overwatch sends during a match and picks out the game server. Each server IP is matched to a region and remembered, so it gets blocked too even if Blizzard moves to new addresses. Check it against the in-game network graph (Ctrl+Shift+N)." />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <ToggleButton x:Name="WatchButton" Click="Watch_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7B3;" FontSize="14" />
                        <TextBlock x:Name="WatchLabel" Text="Start watching" />
                    </StackPanel>
                </ToggleButton>
                <TextBlock x:Name="WatchStatus" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Grid Padding="20,16" CornerRadius="8" RowSpacing="6" ColumnSpacing="24"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Current match server" Grid.ColumnSpan="2" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="CurrentServer" Grid.Row="1" Grid.ColumnSpan="2" Text="No match detected" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="CurrentDetail" Grid.Row="2" Grid.ColumnSpan="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </Grid>

            <TextBlock Text="Busiest destinations (last 5 s)" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock x:Name="TopList" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="—" />

            <TextBlock Text="Learned servers" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Change the server if a guess is wrong, or set one for an unknown IP. Its /24 block gets added to that server's block list (click Apply on Servers)." />
            <ListView x:Name="LearnedList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="app:LearnedItem">
                        <Grid ColumnSpacing="12" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Ip}" FontFamily="Consolas" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Owner}" />
                                <TextBlock Text="{x:Bind Seen}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="2" Tag="{x:Bind Ip}" HorizontalAlignment="Stretch" Loaded="ServerCombo_Loaded" SelectionChanged="ServerCombo_SelectionChanged" />
                            <Button Grid.Column="3" Tag="{x:Bind Ip}" Click="Forget_Click" ToolTipService.ToolTip="Forget this IP">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
