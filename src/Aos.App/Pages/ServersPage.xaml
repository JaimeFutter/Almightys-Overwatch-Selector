<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Aos.App.Pages.ServersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:app="using:Aos.App">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Fixed header -->
        <StackPanel Margin="{StaticResource PageHeaderMargin}" MaxWidth="{StaticResource PageMaxWidth}" Spacing="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Servers" Style="{StaticResource TitleTextBlockStyle}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="UnblockAllButton" Content="Unblock all" Click="UnblockAll_Click" />
                    <Button x:Name="ApplyButton" Style="{StaticResource AccentButtonStyle}" Click="Apply_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" />
                            <TextBlock Text="Apply" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="StatusText" Style="{StaticResource PageDescriptionStyle}" />
            <CommandBar HorizontalAlignment="Left" DefaultLabelPosition="Right" Margin="-4,0,0,0">
                <AppBarButton Label="Block Middle East" Click="BlockMiddleEast_Click" ToolTipService.ToolTip="Block every Middle East server (Qatar, Saudi Arabia, Bahrain, Tel Aviv)">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8F8;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Only allow…" Icon="Filter">
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="PresetMenu" />
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton Label="Allow all" Icon="Accept" Click="AllowAll_Click" />
                <AppBarSeparator />
                <AppBarButton Label="Ping" Click="Ping_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xEC05;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Refresh IPs" Icon="Refresh" Click="Refresh_Click" />
            </CommandBar>
        </StackPanel>

        <!-- Scrolling content: the ScrollViewer spans the full width so its scrollbar sits at the window edge. -->
        <ScrollViewer Grid.Row="1" Padding="{StaticResource PageScrollPadding}">
            <Grid MaxWidth="{StaticResource PageMaxWidth}" Margin="{StaticResource PageContentMargin}">
                <ProgressRing x:Name="Busy" IsActive="True" Width="40" Height="40" Margin="0,40,0,0" VerticalAlignment="Top" />
                <ItemsControl x:Name="Groups">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="app:RegionGroup">
                            <StackPanel>
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource SectionHeaderStyle}" />
                                <ItemsRepeater ItemsSource="{x:Bind Servers}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="{StaticResource SettingsCardSpacing}" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="app:ServerItem">
                                            <tk:SettingsCard>
                                                <tk:SettingsCard.HeaderIcon>
                                                    <FontIcon Glyph="{x:Bind StateGlyph, Mode=OneWay}" />
                                                </tk:SettingsCard.HeaderIcon>
                                                <tk:SettingsCard.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind Title}" />
                                                        <Border Visibility="{x:Bind ExperimentalVisibility}" CornerRadius="4" Padding="6,1"
                                                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" VerticalAlignment="Center">
                                                            <TextBlock Text="experimental" FontSize="11" />
                                                        </Border>
                                                    </StackPanel>
                                                </tk:SettingsCard.Header>
                                                <tk:SettingsCard.Description>
                                                    <StackPanel>
                                                        <TextBlock>
                                                            <Run Text="{x:Bind Location}" /><Run Text="  ·  " /><Run Text="{x:Bind PingText, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{x:Bind RangeText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                            <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                                      Visibility="{x:Bind WarningVisibility, Mode=OneWay}"
                                                                      ToolTipService.ToolTip="{x:Bind WarningText, Mode=OneWay}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </tk:SettingsCard.Description>
                                                <ToggleSwitch IsOn="{x:Bind IsAllowed, Mode=TwoWay}" OnContent="Allowed" OffContent="Blocked" />
                                            </tk:SettingsCard>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
